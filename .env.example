# Copy this file to .env and fill in real values. Never commit .env itself.

# ------------------------------------------------------------------
# Core
# ------------------------------------------------------------------
PROJECT_NAME=shareprice
ENV_TYPE=local
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
HOST_URL=http://localhost:8000

# ------------------------------------------------------------------
# Database (MySQL)
# ------------------------------------------------------------------
DB_NAME=shareprice_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# ------------------------------------------------------------------
# Redis (cache & Celery broker)
# ------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ------------------------------------------------------------------
# CORS / CSRF
# ------------------------------------------------------------------
ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=True
# Comma-separated list, only needed if CORS_ALLOW_ALL_ORIGINS=False
CSRF_TRUSTED_ORIGINS=

# ------------------------------------------------------------------
# Email
# ------------------------------------------------------------------
EMAIL_HOST_USER=noreply@example.com
EMAIL_PASSWORD=
EMAIL_USERNAME=
EMAIL_PORT=587
EMAIL_SMTP_SERVER=smtp.gmail.com
DOMAIN_SENDER_ADDRESS=noreply@example.com
SUPPORT_EMAIL=
ADMIN_EMAIL=

# ------------------------------------------------------------------
# Google Cloud Storage (optional — only needed if you use core/gcp)
# ------------------------------------------------------------------
# STORAGE_CRED_JSON=creds/storage_creds.json
# STORAGE_BUCKET_NAME=your-bucket-name

# ------------------------------------------------------------------
# Production / preproduction only — used by app/config/database.py
# when ENV_TYPE is not "local"
# ------------------------------------------------------------------
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=
