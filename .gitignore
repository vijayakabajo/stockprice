# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Django
*.sqlite3
media/
staticfiles/

# Editor files
.vscode/
.idea/
*.swp
*.swo

# Environment files and secrets (examples are tracked, real files are not)
.env
secrets/*.secrets
!secrets/*.secrets.example

# Virtualenv
env/
venv/
.venv/

# Logs
logs/*
!logs/.gitkeep
*.log

# Lint caches
.ruff_cache/

# Celery beat schedule state
celerybeat-schedule*

# Node: dev-only asset toolchain (built output in web/static/ is committed)
node_modules/
