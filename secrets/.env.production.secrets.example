# Production secrets file — copy to .env.production.secrets and fill in.
# Loaded (and overrides .env) when ENV_TYPE=production. Never commit the real file.
#
# Also how to run syncs from your own machine against Render (see DEPLOY.md):
# fill in the External URLs from the Render dashboard, then run
# manage.py commands with ENV_TYPE=production.

DEBUG=False
SECRET_KEY=
MASSIVE_API_KEY=
# Same value as SITE_URL on the Render web service.
SITE_URL=

# Render Postgres "External Database URL" (postgresql://...)
DATABASE_URL=
# Render Key Value "External Key Value URL" (rediss://...)
REDIS_URL=

# Or, instead of the two URLs above:
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=
# REDIS_HOST=
# REDIS_PORT=
