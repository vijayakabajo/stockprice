    {
      "id": "76c4b625-3004-5752-b2b7-8b63e1523932",
      "name": "Caching",
      "description": "Run these two in order (or run the folder). The first saves the ETag, the second sends it back and should get 304 Not Modified with an empty body.",
      "item": [
        {
          "id": "dfde26dc-a22f-5dc8-9093-e68d376c0e49",
          "name": "1. Get profile and save ETag",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"has ETag\", () => pm.response.to.have.header(\"ETag\"));",
                  "pm.test(\"cacheable for 5 minutes\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"public, max-age=300\"));",
                  "pm.collectionVariables.set(\"etag\", pm.response.headers.get(\"ETag\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/stocks/{{ticker}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "stocks",
                "{{ticker}}",
                ""
              ]
            },
            "description": ""
          },
          "response": []
        },
        {
          "id": "7c1a1142-2c69-54be-9f6c-5b899b8430d0",
          "name": "2. Same request with If-None-Match (304)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"304 Not Modified\", () => pm.response.to.have.status(304));",
                  "pm.test(\"empty body\", () => pm.expect(pm.response.text()).to.eql(\"\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "If-None-Match",
                "value": "{{etag}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/stocks/{{ticker}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "stocks",
                "{{ticker}}",
                ""
              ]
            },
            "description": ""
          },
          "response": []
        }
      ]
    },
