                  "const body = pm.response.json();",
                  "pm.test(\"success envelope\", () => pm.expect(body.success).to.eql(true));",
                  "const data = body.data;",
                  "pm.test(\"blocks present\", () => pm.expect(data).to.include.keys(\"rank\",\"ranked_total\",\"context\",\"peers\",\"related\",\"as_of\"));",
                  "pm.test(\"context includes this stock\", () => pm.expect(data.context.map(r => r.ticker)).to.include(data.ticker));",
                  "pm.test(\"related excludes this stock\", () => pm.expect(data.related.map(r => r.ticker)).to.not.include(data.ticker));",
                  "pm.test(\"at most 3 related\", () => pm.expect(data.related.length).to.be.at.most(3));"
