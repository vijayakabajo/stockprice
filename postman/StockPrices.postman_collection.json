{
  "info": {
    "_postman_id": "bf7a7987-a3db-5528-844a-3ad677a14e3d",
    "name": "StockPrices API",
    "description": "The read-only page API behind the Equity Profiles site. No auth.\n\nSelect the **StockPrices \u2014 local** environment, or edit the `host` variable. Every request has tests: use **Run collection** to check them all at once.\n\nFull reference: API.md in the repo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "id": "c5f1c59c-4808-5307-ae0b-cdb0ea8ea150",
      "name": "Pages",
      "description": "One request per page or page block. Change the collection variables `ticker`, `sector` and `exchange` to try other companies.",
      "item": [
        {
          "id": "ba521bcf-49f3-5012-af67-52c0ce3d4740",
          "name": "Overview (home)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"success envelope\", () => pm.expect(body.success).to.eql(true));",
                  "const data = body.data;",
                  "pm.test(\"headline stats\", () => pm.expect(data).to.include.keys(\"companies\",\"total_market_cap\",\"sectors_covered\",\"by_sector\",\"by_exchange\",\"by_size\",\"largest\",\"as_of\"));",
                  "pm.test(\"largest has 6 or fewer\", () => pm.expect(data.largest.length).to.be.at.most(6));",
                  "pm.test(\"Not classified sorts last\", () => {",
                  "  const slugs = data.by_sector.map(s => s.slug);",
                  "  const i = slugs.indexOf(\"not-classified\");",
                  "  pm.expect(i === -1 || i === slugs.length - 1).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/overview/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "overview",
                ""
              ]
            },
            "description": "Headline stats, counts by sector / exchange / size, and the 6 largest companies."
          },
          "response": []
        },
        {
          "id": "c692ff21-6e27-53e0-b3b5-bef53da7bb9e",
          "name": "Stock directory",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"success envelope\", () => pm.expect(body.success).to.eql(true));",
                  "const data = body.data;",
                  "const rowFields = [\"ticker\",\"display_name\",\"name\",\"security_type\",\"exchange\",\"sector\",\"hq\",\"total_employees\",\"market_cap\",\"size_bucket\",\"indexable\"];",
                  "pm.test(\"pagination fields\", () => pm.expect(data).to.include.keys(\"count\",\"page\",\"page_size\",\"num_pages\",\"results\",\"as_of\"));",
                  "pm.test(\"rows have the stock-row fields\", () => data.results.forEach(r => pm.expect(r).to.include.keys(rowFields)));",
                  "pm.test(\"page_size respected\", () => pm.expect(data.results.length).to.be.at.most(data.page_size));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/stocks/?ordering=-market_cap&page=1&page_size=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "stocks",
                ""
              ],
              "query": [
                {
                  "key": "exchange",
                  "value": "{{exchange}}",
                  "description": "Exchange slug: nasdaq, nyse, nyse-american, ...",
                  "disabled": true
                },
                {
                  "key": "sector",
                  "value": "{{sector}}",
                  "description": "Sector slug, or not-classified",
                  "disabled": true
                },
                {
                  "key": "type",
                  "value": "spac",
                  "description": "common | adr | spac",
                  "disabled": true
                },
                {
                  "key": "size",
                  "value": "mega",
                  "description": "mega | large | mid | small | micro | nano | unknown",
                  "disabled": true
                },
                {
                  "key": "q",
                  "value": "acquisition",
                  "description": "Ticker prefix or name text",
                  "disabled": true
                },
                {
                  "key": "ordering",
                  "value": "-market_cap",
                  "description": "-market_cap (default) | name | ticker | -employees"
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "1, 2, ..."
                },
                {
                  "key": "page_size",
                  "value": "10",
                  "description": "1-100, default 50"
                }
              ]
            },
            "description": "The directory. Tick the query parameters to filter; all filters combine with AND. Unknown values return 400 listing the valid ones."
          },
          "response": []
        },
        {
          "id": "a36b7aa7-4885-5d6c-9458-1ea03ab3871a",
          "name": "Stock profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"success envelope\", () => pm.expect(body.success).to.eql(true));",
                  "const data = body.data;",
                  "pm.test(\"ticker matches\", () => pm.expect(data.ticker).to.eql(pm.collectionVariables.get(\"ticker\").toUpperCase()));",
                  "pm.test(\"profile fields\", () => pm.expect(data).to.include.keys(\"description\",\"website\",\"address\",\"cik\",\"shares_outstanding\",\"edgar_url\",\"active\",\"as_of\",\"indexable\"));",
                  "pm.test(\"labels are {slug, name}\", () => pm.expect(data.sector).to.have.keys(\"slug\",\"name\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/stocks/{{ticker}}/",
              "host": [
                "{{baseUrl}}"
